# All of this is optional — the first-run wizard at http://localhost:9797/ui
# sets up the Webshare account and generates an API key for you.
# Values saved in the UI (persisted to /config/settings.json) override these.
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
#WEBSHARR_API_KEY=
# TMDB API Read Access Token (v4 bearer) for Czech-title lookups; also settable in the UI.
#TMDB_TOKEN=
# Apprise notification URLs (comma-separated) for failure/VIP alerts; also settable in the UI.
#NOTIFY_URLS=
# Download backend: direct (built-in, default) or pyload. pyLoad settings can also be set in the UI.
#DOWNLOAD_BACKEND=direct
#PYLOAD_URL=http://pyload:8000
# pyLoad API key (created in the pyLoad web UI, starts with pl_).
#PYLOAD_API_KEY=
# Where Websharr sees the pyLoad storage folder (default /downloads).
#PYLOAD_DOWNLOAD_DIR=/downloads
# Fail a pyLoad job after this many hours without byte progress (default 24).
#PYLOAD_STALL_HOURS=24

# The user the container runs as — set to your host UID/GID (`id -u` / `id -g`)
# so downloaded files belong to you. Defaults to 1000:1000.
#PUID=1000
#PGID=1000

# Host paths (Portainer: set these as stack environment variables).
# DOWNLOADS_DIR must be the same folder Sonarr/Radarr see as their download dir.
#DOWNLOADS_DIR=/data/downloads/websharr
#CONFIG_DIR=./config
#WEBSHARR_PORT=9797
